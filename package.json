{
  "name": "xuanniao",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node server/index.js",
    "dev": "node server/index.js",
    "web:dev": "vite --host 127.0.0.1 --port 5173 --open",
    "web:build": "vite build",
    "lint": "node --check server/index.js && node --check server/lib/*.js && tsc --noEmit",
    "format:check": "node scripts/check-format.mjs",
    "test": "tsx --test server/lib/*.test.js web/src/*.test.ts web/src/components/*.test.tsx web/src/hooks/*.test.ts",
    "check": "npm run lint && npm run format:check && npm test && npm run web:build"
  },
  "dependencies": {
    "@codemirror/commands": "^6.8.0",
    "@codemirror/lang-markdown": "^6.3.0",
    "@codemirror/state": "^6.5.0",
    "@codemirror/view": "^6.38.0",
    "@vitejs/plugin-react": "^5.1.0",
    "markdown-it": "^14.1.0",
    "mermaid": "^11.15.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "vite": "^7.2.0"
  },
  "devDependencies": {
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^20.19.43",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "tsx": "^4.23.1",
    "typescript": "^5.9.0"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  }
}
